{
  "mcpServers": {
    "team-knowledge-base": {
      "command": "mcp-kb-server",
      "args": [],
      "env": {
        "KB_ID": "<knowledge-base-id>",
        "AWS_PROFILE": "bedrock",
        "AWS_REGION": "<region>",
        "KB_TOP_K": "6"
      },
      "disabled": false,
      "autoApprove": ["search_knowledge_base", "knowledge_base_info"]
    },
    "issue-tracker": {
      "command": "/absolute/path/to/bedrock-cline-platform/cline/mcp/run-with-secrets.sh",
      "args": ["<prefix>/mcp/issue-tracker", "node", "/absolute/path/to/issue-tracker-mcp/dist/index.js"],
      "env": { "AWS_PROFILE": "bedrock", "AWS_REGION": "<region>" },
      "disabled": false,
      "autoApprove": ["<read-only tool names with bounded output>"]
    },
    "database-dev": {
      "command": "/absolute/path/to/bedrock-cline-platform/cline/mcp/run-with-secrets.sh",
      "args": ["<prefix>/mcp/database-dev", "node", "/absolute/path/to/database-mcp/dist/index.js"],
      "env": { "AWS_PROFILE": "bedrock", "AWS_REGION": "<region>" },
      "disabled": false,
      "autoApprove": ["<schema inspection tools only>"]
    },
    "remote-example": {
      "url": "https://mcp.internal.example/mcp",
      "type": "streamableHttp",
      "disabled": true,
      "autoApprove": []
    }
  }
}
